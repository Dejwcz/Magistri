@using Magistri.DTO
@model LoginDto
@{
    ViewData["Title"] = "Login";
}
<div class=" text-center">
    <h1>Welcome</h1>
</div>
<div class="text-danger" asp-validation-summary="All"></div>
<form asp-action="Login" method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <div class="form-group">
        <label asp-for="UserName"></label>
        <input asp-for="UserName" class="form-control" />
    </div>
    <div class="form-group mb-2">
        <label asp-for="Password"></label>
        <input asp-for="Password" class="form-control" type="password"/>
        @* Remember me? <input type="checkbox" asp-for="Remember" /> *@
    </div>
    <button class="btn btn-lg w-100 btn-dark" type="submit">Log In</button>
</form>
<br />
<div class="text-center">
    <a asp-controller="Home" asp-action="Info" class="btn btn btn-outline-dark mt-5 btn-sm">Push me for login info</a>
</div>