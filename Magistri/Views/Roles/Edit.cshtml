@model RoleEdit
@{
    ViewData["Title"] = "UPDATE ROLE";
}
<div class="row">
    <div class="col-9">
        <h1 class="">Edit Role</h1>
    </div>
    <div class="col-3">
        <a asp-action="Index" class="btn btn-outline-dark w-100">Back</a>
    </div>
</div>
<hr />
<div asp-validation-summary="All" class="text-danger"></div>
<form method="post">
    <input type="hidden" name="roleName" value="@Model.Role.Name" />
    <input type="hidden" name="roleId" value="@Model.Role.Id" />
    <h2 class="bg-dark p-1 text-white rounded-3">Add To @Model.Role.Name</h2>
    <table class="table table-bordered table-sm">
        @if (Model.NonMembers.Count() == 0) {
            <tr><td colspan="2">All Users Are Members</td></tr>
        }
        else {
            @foreach (AppUser user in Model.NonMembers) {
                <tr>
                    <td>@user.UserName</td>
                    <td>
                        <input type="checkbox" name="AddIds" value="@user.Id">
                    </td>
                </tr>
            }
        }
    </table>
    <h2 class="bg-dark p-1 text-white rounded-3">Remove From @Model.Role.Name</h2>
    <table class="table table-bordered table-sm">
        @if (Model.Members.Count() == 0) {
            <tr><td colspan="2">No Users Are Members</td></tr>
        }
        else {
            @foreach (AppUser user in Model.Members) {
                <tr>
                    <td>@user.UserName</td>
                    <td>
                        <input type="checkbox" name="DeleteIds" value="@user.Id">
                    </td>
                </tr>
            }
        }
    </table>
    <button type="submit" class="btn btn-dark">Save</button>
</form>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}
