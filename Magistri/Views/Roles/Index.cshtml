@using Microsoft.AspNetCore.Identity
@model IEnumerable<IdentityRole>
@{
    ViewData["Title"] = "ROLES";
}
<div class="row">
    <div class="col-9">
        <h1 class="">List of all roles</h1>
    </div>
    <div class="col-3">
        <a asp-action="Index" asp-controller="Home" class="btn btn-outline-dark w-100">Home</a>
    </div>
</div>
<hr />
<a asp-action="Create" class="btn btn-outline-dark mb-2">Create a Role</a>
<table class="table table-sm table-bordered border-dark">
    <tr>
        <th>Name</th>
        <th>Edit</th>
        <th>Delete</th>
        <th>ID</th>
    </tr>
    @foreach (var role in Model) {
        <tr>
            <td>@role.Name</td>
            <td>
                @if (role.Name != "Admin")
                {
                    <a class="btn btn-sm btn-dark w-100" asp-action="Edit" asp-route-id="@role.Id">Edit</a>
                }
            </td>
            <td>
                @if (role.Name != "Admin") {
                <button type="button"
                        class="btn btn-sm btn-danger w-100"
                        data-bs-toggle="modal"
                        data-bs-target="#modal-@role.Id">
                    Delete
                </button>
                <div class="modal fade" id="modal-@role.Id" tabindex="-1" aria-labelledby="modalLabel-@role.Id" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <form asp-action="Delete" asp-route-id="@role.Id" method="post">
                                @Html.AntiForgeryToken()
                                <div class="modal-header">
                                    <h1 class="modal-title fs-5" id="modalLabel-@role.Id">Are you sure?</h1>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    Do you want to delete the role <strong>@role.Name</strong>?
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">Back</button>
                                    <button type="submit" class="btn btn-dark">Confirm</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                }
            </td>
            <td>@role.Id</td>
        </tr>
    }
</table>

