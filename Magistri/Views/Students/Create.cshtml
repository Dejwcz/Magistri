@using Magistri.DTO
@model StudentDto
<div class="row">
    <div class="col-9">
        <h1>Create a new student</h1>
    </div>
    <div class="col-3">
        <a asp-action="Index" class="btn btn-outline-dark w-100">Back</a>
    </div>
</div>
<hr />
<form asp-controller="Students" asp-action="Create">
<div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="FirstName"></label>
        <input type="text" asp-for="FirstName" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="LastName"></label>
        <input type="text" asp-for="LastName" class="form-control" />
    </div>
    <div class="form-group mb-2">
        <label asp-for="DateOfBirth"></label>
        <input type="date" asp-for="DateOfBirth" class="form-control" />
    </div>
    <div>
        <input class="btn btn-dark" type="submit" value="Create" />
    </div>
</form>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial" />
    }
}

