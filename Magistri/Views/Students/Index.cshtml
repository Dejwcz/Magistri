@using Magistri.DTO
@model IEnumerable<StudentDto>
<div class="row">
    <div class="col-9">
        <h1 class="">List of all students</h1>
    </div>
    <div class="col-3">
        <a asp-action="Index" asp-controller="Home" class="btn btn-outline-dark w-100">Home</a>
    </div>
</div>
<hr />
@if (User.Identity.IsAuthenticated && (User.IsInRole("Admin") || (User.IsInRole("Teacher"))))
{
    <form method="post" class="" enctype="multipart/form-data" asp-controller="FileUpload" asp-action="Upload">
        <div class="row mb-2">
            <label for="formFile" class="form-label">For import students</label>
            <div class="col-6">
                <div class="mb-3">
                    <input class="form-control btn btn-dark" type="file" id="formFile" name="file">
                </div>
            </div>
            <div class="col-6">
                <div class="form-group ">
                    <input class="btn btn-outline-dark" type="submit" value="Upload" />
                </div>
            </div>
        </div>
    </form>
<hr />
}
<div>
    @if (User.Identity.IsAuthenticated && User.IsInRole("Admin")) {
        <a class="btn btn-outline-dark mb-2" asp-action="Create">Create a new student</a>
    }
</div>


@foreach (var item in Model) {
    <div class="border border-1 border-dark p-2 rounded-3 mt-1">
        <h5>@item.FirstName @item.LastName</h5>
        Id: @item.Id
        <p>Date of Birth: @item.DateOfBirth.ToShortDateString()</p>
        @if (User.Identity.IsAuthenticated && (User.IsInRole("Admin") || (User.IsInRole("Teacher"))))
        {
            <a class="btn btn-dark" asp-action="Edit" asp-route-id=@item.Id>Edit</a>
        }
        @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
        {
            <button type="button"
                        class="btn btn btn-danger"
                        data-bs-toggle="modal"
                        data-bs-target="#modal-@item.Id">
                    Delete
                </button>
                <div class="modal fade" id="modal-@item.Id" tabindex="-1" aria-labelledby="modalLabel-@item.Id" aria-hidden="true">
                    <div class="modal-dialog">
                        <div class="modal-content">
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                                @Html.AntiForgeryToken()
                                <div class="modal-header">
                                <h1 class="modal-title fs-5" id="modalLabel-@item.Id">Are you sure?</h1>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                Do you want to delete the student <strong>@item.FirstName @item.LastName</strong>?
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">Back</button>
                                    <button type="submit" class="btn btn-dark">Confirm</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
        }
    </div>
}



