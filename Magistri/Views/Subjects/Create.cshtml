@using Magistri.DTO
@model SubjectDto
<div class="row">
    <div class="col-9">
        <h1>Create a new subject</h1>
    </div>
    <div class="col-3">
        <a asp-action="Index" class="btn btn-outline-dark w-100">Back</a>
    </div>
</div>
<hr />
<form asp-controller="Subjects" asp-action="Create">
<div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="Name"></label>
        <input type="text" asp-for="Name" class="form-control" />
    </div>
    <div>
        <input class="btn btn-dark mt-2" type="submit" value="Create" />
    </div>
</form>

@section Scripts {
    @{
        <partial name="_ValidationScriptsPartial"/>
    }
}


